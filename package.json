{
  "name": "hogyoku-rag",
  "version": "2.0.0",
  "private": true,
  "description": "Conversational multimodal RAG workspace with cited, verified answers.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "bash scripts/verify.sh",
    "evaluate": "python scripts/evaluate_retrieval.py evaluations/example.jsonl",
    "guardrails": "python scripts/run_guardrails.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "@google/genai": "^2.15.0",
    "bullmq": "^6.0.8",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "ioredis": "^6.0.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2"
  }
}
